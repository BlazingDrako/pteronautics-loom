{
  "name": "Pteronautics Loom",
  "short_name": "Loom",
  "description": "Model-based systems engineering with SysML: requirements, functions, architecture and verification, traced end to end.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0b0d11",
  "theme_color": "#0b0d11",
  "categories": ["productivity", "developer", "education"],
  "icons": [
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".json"] }, "launch_type": "single-client" },
    { "action": "./", "accept": { "text/plain": [".sysml"] }, "launch_type": "single-client" },
    { "action": "./", "accept": { "application/zip": [".zip", ".mdzip", ".reqifz"], "application/xml": [".xmi", ".reqif"] }, "launch_type": "single-client" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "shortcuts": [
    { "name": "New project", "url": "./#new", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
