{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pteronautics Loom",
  "version": "1.0.0",
  "identifier": "io.github.blazingdrako.loom",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pteronautics Loom",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http: https:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Model-based systems engineering with SysML",
    "longDescription": "Pteronautics Loom: model requirements, functions, logical and physical architecture, interfaces and verification in SysML, traced end to end.",
    "copyright": "Copyright (C) 2026 Andrew Aguiar",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sysml"
        ],
        "name": "SysML v2 text",
        "description": "SysML v2 textual model",
        "role": "Editor"
      }
    ]
  }
}
